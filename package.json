{
  "name": "pingr",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@pingr/web",
    "dev:server": "turbo dev --filter=@pingr/server",
    "dev:bot": "turbo dev --filter=@pingr/bot",
    "build": "turbo build",
    "db:push": "pnpm --filter @pingr/server db:push",
    "db:studio": "pnpm --filter @pingr/server db:studio"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.32.1"
}
